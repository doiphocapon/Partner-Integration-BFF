{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SupportedCurrencies": {
    "Values": [ "USD", "EUR", "GBP", "JPY", "VND", "AUD", "CAD" ]
  },
  "PartnerVerification": {
    "BaseUrl": "http://localhost:5095/",
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMilliseconds": 200,
    "AttemptTimeoutMilliseconds": 2000
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "app",
    "Password": "app-dev-only-password",
    "VirtualHost": "/",
    "QueueName": "partner-transactions"
  },
  "Security": {
    "ApiKey": "local-dev-partner-key"
  }
}
